# Supabase project settings (Project Settings -> API)
SUPABASE_URL=https://your-project.supabase.co
# Service-role key: SERVER ONLY. Never put this in the client.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

PORT=4000
# Where the React app runs (for CORS)
CLIENT_ORIGIN=http://localhost:5173

# Only students with this email domain can sign in.
# Advisors are allowed if their email is pre-registered in public.users.
STUDENT_EMAIL_DOMAIN=mail.kmutt.ac.th

# false = only students already in the roster (CSV import / added by an
# advisor) can link their account. true = any student with a valid
# student ID can create their own record on first login.
ALLOW_SELF_REGISTER=false
# Optional: if self-register is on, require the student ID to start with
# this prefix (e.g. your cohort's prefix). Leave empty to skip the check.
STUDENT_ID_PREFIX=
