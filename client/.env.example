# Supabase project settings (Project Settings -> API)
# The anon key is safe in the browser: it is only used for Google sign-in.
# All data goes through the Express API.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Express API base URL
VITE_API_URL=http://localhost:4000

# Shown as a hint on Google's account picker
VITE_STUDENT_EMAIL_DOMAIN=mail.kmutt.ac.th
